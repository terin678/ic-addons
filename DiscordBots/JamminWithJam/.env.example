# Copy this file to .env and fill in the token. .env is gitignored -- a
# token is a credential, and anyone who has it can act as your bot.
#
# Discord Developer Portal -> your application -> Bot -> Reset Token.
# The bot also needs the "Connect" and "Speak" permissions on the voice
# channel named in config.json, and must be invited to the server with the
# bot scope (no special privileged intents are required).
DISCORD_TOKEN=

# Optional overrides; the defaults are fine for a normal checkout.
# JAM_CONFIG_PATH=./config.json
# JAM_SOUNDS_DIR=./sounds
